#!ipxe
set base http://192.168.50.1
echo
echo === PoC: Ubuntu 24.04 Autoinstall ===
echo IP: ${ip}   MAC: ${net0/mac}
echo
sleep 3
kernel ${base}/ubuntu/vmlinuz initrd=initrd ip=dhcp url=${base}/ubuntu/ubuntu-24.04.5-live-server-amd64.iso cloud-config-url=/dev/null autoinstall ds=nocloud-net;s=${base}/autoinstall/ || goto failed
initrd --name initrd ${base}/ubuntu/initrd || goto failed
boot || goto failed

:failed
echo === Boot failed ===
sleep 10
shell
